{
  "name": "conferencia-datas",
  "private": true,
  "type": "module",
  "scripts": {
    "build:client": "vite build",
    "build:server": "node gerar-registro.mjs && esbuild server/index.ts --bundle --platform=node --target=node22 --format=cjs --outfile=deploy/server.js --external:mongodb --alias:@generated=./src/generated --alias:@vibe/db/server=./server/vibeDb.ts --alias:@vibe/db=./src/shims/vibe-db.ts --alias:@tanstack/react-start=./server/serverFn.ts --log-level=warning",
    "build": "npm run build:client && npm run build:server",
    "typecheck": "tsc --noEmit -p ."
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.5",
    "@types/node": "^22.20.5",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^4.7.0",
    "esbuild": "^0.28.2",
    "tailwindcss": "^4.3.5",
    "typescript": "^7.0.2",
    "vite": "^6.4.6"
  },
  "dependencies": {
    "lucide-react": "^1.79.0",
    "monday-sdk-js": "^0.5.9",
    "mongodb": "^7.9.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "zod": "^3.25.76"
  }
}
